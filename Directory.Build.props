<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Authors>TurboTest Contributors</Authors>
    <Company>TurboTest</Company>
    <Product>TurboTest</Product>
    <Copyright>Copyright (c) TurboTest Contributors</Copyright>
    <RepositoryUrl>https://github.com/yourusername/TurboTest</RepositoryUrl>
    <PackageProjectUrl>https://github.com/yourusername/TurboTest</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
