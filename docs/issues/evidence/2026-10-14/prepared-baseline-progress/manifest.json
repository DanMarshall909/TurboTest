  "phaseNotes": {
    "seed-red": "Compiling baseline scaffold ignored initialization; expected one initializer, actual zero.",
    "verify-red": "Three actual clone corruptions were accepted; no validation exception.",
    "configuration-red": "Five missing version/schema/per-lease configuration rules.",
    "redirect-red": "External database redirection reached initialization instead of being rejected with BaselineConfiguration.",
    "catalog-red": "Six unsupported catalog/database configurations were accepted.",
    "verify-green": "Failed candidate: redacted datasource connection string lacked admin password. This is a setup defect, not a valid RED.",
    "boundary-green": "Failed candidate: Npgsql Host/Port are unavailable before opening; valid fixture connections were falsely rejected. This is a regression, not a valid RED.",
    "validation-fault": "Removing the manifest validation gate makes all four difference oracles fail. Source restored by receipt hash.",
    "migration-fault": "Substituting EnsureCreated for explicit migrations makes the migration-only fixture fail with SQLSTATE 42P01. Source restored by receipt hash.",
    "catalog-hygiene-fault": "Removing supported-catalog rejection makes all six no-publication assertions fail; every unexpectedly published factory is disposed and no TurboTest container remains. Source restored by matching receipt digest."
  },
  "refactor": {
    "production": "Prepared pool separated from legacy pooled reset. Frozen EF model/options bind one owner, context type, schema mode and initializer version. Snapshot comparison and capture separated from ownership; sorted binary-row hashes retain counts/digests rather than seed payload. Logins are private immutable values, admin sources are never handed to workloads. Exact datasource identity uses one narrowly scoped pinned Npgsql options API because endpoint equality cannot prove source ownership.",
    "tests": "One three-table public oracle plus focused migration/caller/permission/failure/catalog cases. Fast manifest comparison tests use independently supplied differences; PostgreSQL corruption cases calibrate the actual capture boundary. No score-driven test consolidation."
  },
  "limits": [
    "No independent completion review or completion commit yet.",
    "No whole-package coverage or mutation proof. Fast manifest validation is covered separately from PostgreSQL capture.",
    "Normal post-session mutation awaits the final committed source snapshot and excludes PostgreSQL/end-to-end tests.",
    "Bounded capacities, recovery, DI/static ownership, parking, metrics and adaptive control remain later tickets.",
    "Supported baseline catalog is explicit and restricted; rejection guards and large-object/default-ACL/publication cases need review against the declared contract.",
    "Snapshots here identify the latest working implementation; earlier phase transcripts are historical and do not claim identical source bytes. Original initial RED/GREEN snapshots remain in their separate manifests."
  ],
