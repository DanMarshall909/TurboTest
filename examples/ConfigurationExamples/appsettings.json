{
  "TurboTest": {
    "Provider": "PostgreSql",
    "PoolSize": 5,
    "AutoMigrate": true,
    "EnableSensitiveDataLogging": true,
    "MemoryLimitMb": 512,
    "ContainerPrefix": "myapp_test",
    "DatabaseName": "my_test_db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}